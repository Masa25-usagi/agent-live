# Keep real values in ~/.config/agent-live/server.env with mode 600.
AGENT_LIVE_TOKEN=replace-with-a-random-device-pairing-secret
AGENT_LIVE_HOST=127.0.0.1
AGENT_LIVE_PORT=8787
AGENT_LIVE_DATA=/home/example/.local/share/agent-live
HERMES_API_URL=http://127.0.0.1:8643
AGENT_LIVE_HERMES_PORT=8643
HERMES_API_KEY=replace-with-a-random-app-only-hermes-secret
HERMES_HOME=/home/example/.hermes
GEMINI_API_KEY=use-your-gemini-api-key
GROQ_API_KEY=use-your-groq-api-key
TYPESAFE_API_KEY=use-your-jev-api-key
# Optional: OPENAI_API_KEY, XAI_API_KEY, AGENT_LIVE_TTS_PROVIDER
# Economy mode is on by default and shared by iPhone, Mac and Discord.
# AGENT_LIVE_ECONOMY=false disables its default for a new data directory.
# Hermes TTS defaults to edge_tts in either economy mode, with an app-only Japanese voice.
# AGENT_LIVE_EDGE_VOICE=ja-JP-NanamiNeural
# DRIVE_FOLDER_ID is populated by script/setup_drive.py after OAuth.
